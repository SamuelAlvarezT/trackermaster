{
  "name": "trackmaster-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "agent": "node --experimental-strip-types agent/cli.ts",
    "test:rules": "firebase emulators:exec --project demo-trackmaster --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "dompurify": "3.2.7",
    "firebase": "12.19.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-tools": "15.32.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.4"
  }
}
